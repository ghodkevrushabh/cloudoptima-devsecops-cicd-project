import os
from flask import Flask, render_template, request, redirect, url_for
from flask_sqlalchemy import SQLAlchemy
from generator import generate_iac

app = Flask(__name__)

app.config['SQLALCHEMY_DATABASE_URI'] = 'postgresql://cloudoptima_admin:SuperSecureDbPassword123!@127.0.0.1:5432/cloudoptima_db'
app.config['SQLALCHEMY_TRACK_MODIFICATIONS'] = False

db = SQLAlchemy(app)

# SET YOUR S3 BUCKET NAME HERE (Created in Phase 1 Step 3)
S3_STATE_BUCKET = "cloudoptima-tf-state-84920" # Replace with your exact bucket name if different

class EnvironmentRequest(db.Model):
    id = db.Column(db.Integer, primary_key=True)
    app_name = db.Column(db.String(50), nullable=False)
    environment = db.Column(db.String(20), nullable=False)
    port = db.Column(db.Integer, nullable=False)
    instance_size = db.Column(db.String(20), nullable=False)
    status = db.Column(db.String(20), default="Pending")

@app.route('/')
def index():
    reqs = EnvironmentRequest.query.order_by(EnvironmentRequest.id.desc()).all()
    return render_template('index.html', requests=reqs)

@app.route('/request', methods=['POST'])
def create_request():
    app_name = request.form['app_name']
    env = request.form['environment']
    port = int(request.form['port'])
    size = request.form['instance_size']
    
    # Save request to PostgreSQL
    new_req = EnvironmentRequest(app_name=app_name, environment=env, port=port, instance_size=size)
    db.session.add(new_req)
    db.session.commit()
    
    # Trigger IaC Generation
    generate_iac(app_name, env, port, size, S3_STATE_BUCKET)
    
    return redirect(url_for('index'))

if __name__ == '__main__':
    with app.app_context():
        db.create_all()
    app.run(host='0.0.0.0', port=8080, debug=True)
